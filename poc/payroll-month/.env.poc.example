# POC environment template (SAFE TO COMMIT — no real secrets here).
# Copy to `.env.poc.local` (git-ignored) and fill in, or just use the shipped
# dev-only defaults in `.env.poc.local`. Load with:
#   set -a; source poc/payroll-month/.env.poc.local; set +a

# --- Postgres (disposable POC cluster; compose variable + app URLs) ---
POC_POSTGRES_DB=poc
POC_POSTGRES_USER=poc
POC_POSTGRES_PASSWORD=
POC_ROLE_PASSWORD=
POC_POSTGRES_PORT=5544
POC_DATABASE_URL=
POC_DBOS_MIGRATE_URL=
POC_DBOS_SCHEMA=dbos

# --- immudb (standalone service + auditor) ---
# Admin bootstrap (first boot only); writer (read-write); auditor (read-only).
POC_IMMUDB_ADMIN_PASSWORD=
POC_IMMUDB_PORT=3322
POC_IMMUDB_ADDR=localhost:3322
POC_IMMUDB_USER=poc_writer
POC_IMMUDB_PASSWORD=
POC_IMMUDB_DB=defaultdb
POC_AUDIT_IMMUDB_USER=poc_auditor
POC_AUDIT_IMMUDB_PASSWORD=
POC_WRITER_STATE_DIR=.poc-writer-state
POC_AUDIT_STATE_DIR=
POC_AUDIT_WEBHOOK=
# --- Postgres auditor (read-only role; see runbook step 3.7) ---
POC_AUDIT_PG_PASSWORD=
POC_AUDIT_DATABASE_URL=

# --- POC run scope (must match the seeded codes: seedpoc EmployerCode/Period) ---
POC_EMPLOYER=POC-MERIDIAN
POC_PERIOD=PP-2026-10
